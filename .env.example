SYNC_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Shared password gate for the whole dashboard.
DASHBOARD_PASSWORD=replace-with-a-strong-shared-password

# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret

# Always-on content-sync API. Approvals call this to publish immediately through Payload.
SYNC_SERVICE_URL=https://your-sync-service.up.railway.app
SYNC_ADMIN_TOKEN=use-the-same-value-as-the-sync-service
